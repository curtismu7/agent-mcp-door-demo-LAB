# Optional. Everything has a safe default; the demo needs no tenant and no credentials.
# The app reads ~/Development/.env (or the file STANDALONE_ENV points at) and uses ONLY the keys below.
# Admin and worker credentials never go there.
# MODE=mock               # the only mode this app has; anything else is refused
# PORT=6850               # 6850-6879
# MCPDOOR_BIND=127.0.0.1  # loopback only unless you set this on purpose
# CUSTOMER_CONFIG=/path/to/customer.config.json
